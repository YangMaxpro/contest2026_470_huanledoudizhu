+
+int bk_fill_rand(void *buff, size_t len)
+{
+    uint8_t *p = buff;
+    if (buff == NULL || len == 0)
+        return -1;
+
+    /* Bound interrupt masking even if another CP caller requests a large
+     * buffer. Each chunk preserves the vendor warm-up/discard sequence. */
+    while (len > 0) {
+        size_t count = len < 32 ? len : 32;
+        if (trng_fill_chunk(p, count) != 0)
+            return -1;
+        p += count;
+        len -= count;
+    }
+    return 0;
+}
